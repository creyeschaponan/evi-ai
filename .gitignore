# =====================================================================
#             .gitignore - EVI Local AI Voice Assistant
# =====================================================================

# 1. Dependencias Node.js / JavaScript
node_modules/
*/node_modules/
client-node/node_modules/
orchestrator-nest/node_modules/
.pnpm-store/
package-lock.json

# 2. Compilados y Builds
dist/
*/dist/
build/
*/build/
orchestrator-nest/dist/

# 3. Variables de Entorno y Secretos (NUNCA subir a GitHub)
.env
.env.local
.env.*.local
*.env

# 4. Entornos Virtuales y Caches de Python
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
.venv/
*/.venv/
env/
venv/
ENV/
*.egg-info/
.pytest_cache/

# 5. Modelos de Inteligencia Artificial y Pesos Pesados (GGUF / PyTorch)
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
pretrained_models/
prompts/
whisper-data/

# 6. Bases de Datos Locales y Almacenamiento Persistente
postgres-data/
*.sqlite
*.sqlite3
*.db
.data/

# 7. Archivos de Audio Temporales y Grabaciones
*.wav
*.mp3
*.ogg
*.flac
temp_audio/

# 8. Logs y Archivos de Depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp

# 9. Configuraciones de IDE y Sistema Operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.gemini/
.agents/
