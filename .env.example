# =====================================================================
#             EVI - Archivo de Configuración de Ejemplo (.env)
# =====================================================================

# PostgreSQL con pgvector (Almacenamiento RAG y Memoria Persistente)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:tu_password_seguro_aqui@localhost:5432/postgres

# Servidor Local LLM (llama.cpp)
LLM_API_URL=http://localhost:8080/v1
LLM_MODEL=Qwen3-8B
LLM_API_KEY=not-needed

# Embeddings Vectoriales (bge-m3)
EMBEDDING_BASE_URL=http://localhost:8081/embedding

# Protocolo Wyoming (Speech-to-Text & Text-to-Speech)
WYOMING_WHISPER_HOST=localhost
WYOMING_WHISPER_PORT=10300
WYOMING_PIPER_HOST=localhost
WYOMING_PIPER_PORT=10200
WYOMING_PIPER_VOICE=es_MX-claude-high
WYOMING_PIPER_LENGTH_SCALE=0.85
WYOMING_WAKEWORD_HOST=localhost
WYOMING_WAKEWORD_PORT=10400

# Microservicios Adicionales de TTS
EDGE_TTS_VOICE=es-MX-DaliaNeural
EDGE_TTS_RATE=+20%
CHATTERBOX_TTS_URL=http://localhost:8020/tts
COSYVOICE_TTS_URL=http://localhost:50000/api/tts

# Backend Server
PORT=3000

# Google Workspace MCP Connectors (Groq Cloud: Gmail & Calendar)
# Scopes: https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.events
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
